# VisionPilot Environment Configuration Example
# Copy this file to .env to customize settings

# Application Environment (development, testing, production)
VISIONPILOT_ENV=development

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
VISIONPILOT_LOG_LEVEL=INFO
VISIONPILOT_LOG_TO_FILE=true

# Safety Settings
# Auto-approve low risk actions
VISIONPILOT_AUTO_APPROVE_LOW_RISK=true
# Require user confirmation for medium risk actions (default: false)
VISIONPILOT_CONFIRM_MEDIUM_RISK=false
# Require user confirmation for high risk actions (always enforced)
VISIONPILOT_CONFIRM_HIGH_RISK=true

# Hardware Acceleration Preference (auto, npu, directml, cpu)
VISIONPILOT_ACCELERATION_MODE=auto

# Storage Settings
VISIONPILOT_DATA_DIR=data
VISIONPILOT_DB_PATH=data/visionpilot.db

# Optional Remote AI Fallback (Leave blank for 100% local operation)
VISIONPILOT_FALLBACK_API_KEY=
VISIONPILOT_FALLBACK_PROVIDER=none
